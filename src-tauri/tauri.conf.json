{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KMail Cleanup",
  "version": "0.2.0",
  "identifier": "app.kmailcleanup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "KMail Cleanup",
      "width": 1320,
      "height": 820,
      "minWidth": 760,
      "minHeight": 680,
      "decorations": true,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Review-first KMail cleanup assistant",
    "longDescription": "Configure cleanup rules from KMail examples, preview matches, and move reviewed mail without deleting it."
  }
}
